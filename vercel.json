{
  "buildCommand": "npm run build",
  "build": {
    "env": {
      "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
    }
  },
  "env": {
    "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.swapuae.com"
        }
      ],
      "destination": "https://swapuae.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/media/:bucket/:path*",
      "destination": "https://supabase.swapuae.com/storage/v1/object/public/:bucket/:path*"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
